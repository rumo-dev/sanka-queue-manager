{
  "name": "twitch-queue-manager",
  "version": "1.2.0",
  "description": "Twitch参加型配信 キュー管理ツール (OBS連携対応)",
  "main": "main.js",
  "author": {
    "name": "rumo-dev",
    "email": "you@example.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-config.js",
    "pack": "electron-builder --dir",
    "dist:win": "npm run check && electron-builder --win --publish never",
    "dist:mac": "npm run check && electron-builder --mac --publish never",
    "dist:linux": "npm run check && electron-builder --linux --publish never",
    "release:win": "npm run check && electron-builder --win --publish always",
    "release:mac": "npm run check && electron-builder --mac --publish always",
    "release:linux": "npm run check && electron-builder --linux --publish always"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rumodev.queue",
    "productName": "Sanka Queue Manager",
    "copyright": "Copyright (c) rumo-dev",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "web/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rumo-dev",
        "repo": "sanka-queue-manager",
        "releaseType": "release"
      }
    ]
  }
}
