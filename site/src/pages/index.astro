---
import Base from '../layouts/Base.astro';
import Downloader from '../components/Downloader.astro';
import { APP_NAME, TAGLINE, RELEASE_REPO } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (f: string) => `${base}/img/${f}`;
const repoUrl = `https://github.com/${RELEASE_REPO}`;

const features = [
  { icon: '⌨', title: '配信しながら、手元で完結', text: 'Space で全員＋1、S で上限者を交代、D で上限者を削除。ゲーム中でも効くホットキーと、別モニターの端に置ける小さなミニ表示、参加・上限到達を知らせる通知音つき。' },
  { icon: '🛡', title: '参加管理もおまかせ', text: 'サブスク/VIP/モデレーターだけに限定、最大人数、退出後の再参加待ち、ブラックリスト。誰がいつ何回参加したかの履歴も残ります。' },
  { icon: '✨', title: '交代が映える演出', text: '去る人のアニメ、出番が来た人の強調、参加・交代・上限到達の効果音 (好きな音声ファイルも使えます)。テーマ10種・表示スタイル6種。' },
  { icon: '🚀', title: 'すぐ使える', text: '初回ガイドに沿ってログイン → 参加方法 → OBS の順に設定するだけ。OBS へは枠をドラッグ＆ドロップで追加。新しい版は自動でお知らせ・更新します。' },
];
const steps = [
  ['インストール', 'ダウンロードしたファイルを開いてインストール。起動すると初回ガイドが始まります。'],
  ['Twitch でログイン', '配信者のアカウントでログインするだけ。Client ID の登録は不要です。'],
  ['OBS にドラッグ', '「オーバーレイをOBSへドラッグ」の枠を OBS の画面へドロップ。参加者が配信画面に出ます。'],
];
const shots = [
  ['queue.png', '操作画面', '別モニターに置いて使うキュー操作画面。行を選んでキーボードでも操作できます。'],
  ['people.png', '参加管理', '参加条件・ブラックリスト・参加履歴をまとめて管理。'],
  ['overlay.png', 'OBS のオーバーレイ', '交代で出番が来た人が光ります。'],
  ['themes.png', 'テーマ', 'テーマ10種、表示スタイル6種。リッチカードで自作デザインも。'],
];
const faq = [
  ['無料ですか？', '無料で使えます。'],
  ['Twitch のパスワードは渡りますか？', 'いいえ。ログインは Twitch の画面で行い、アプリには渡りません。ログイン情報 (トークン) はお使いの PC の中にだけ、OS の暗号化機能で保存されます。'],
  ['インストール時に警告が出ます', '個人配布のため、コード署名がありません。Windows は「詳細情報 → 実行」、macOS はアプリを右クリック →「開く」で起動できます。ダウンロードは、このページのリンク (GitHub) からのものだけを使ってください。'],
  ['自動で更新されますか？', 'インストーラー版 (Windows) / AppImage (Linux) は、新しい版が出ると自動でダウンロードして知らせます。ポータブル版は自動更新に対応していないため、このページから最新版を入れ直してください。'],
  ['OBS に表示されません', 'アプリを起動したままにしてください (表示はアプリが配信しています)。ポートが変わった場合は、アプリに表示される URL を使います。'],
  ['どの OS で使えますか？', 'Windows 10 以降、macOS (Intel / Apple Silicon)、Linux (AppImage)。'],
];
---
<Base>
  <header class="top">
    <div class="wrap bar">
      <a class="brand" href={`${base}/`}><svg width="28" height="28" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#171a27"/><rect x="12" y="14" width="40" height="10" rx="4" fill="#6ea8ff"/><rect x="12" y="27" width="40" height="10" rx="4" fill="#3ecf8e"/><rect x="12" y="40" width="40" height="10" rx="4" fill="#f5b700"/></svg>{APP_NAME}</a>
      <nav aria-label="ページ内メニュー"><a href="#features">特長</a><a href="#start">はじめかた</a><a href="#faq">よくある質問</a><a href={repoUrl}>GitHub</a></nav>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-text">
          <p class="eyebrow">Twitch 参加型配信のキュー管理ツール</p>
          <h1>{TAGLINE}</h1>
          <p class="lead">視聴者の参加を自動でキューに並べ、回数の管理・交代・OBS への表示までひとつに。Windows / macOS / Linux 対応。</p>
          <Downloader />
        </div>
        <img class="hero-shot" src={img('queue.png')} alt="キュー操作画面。プレイ中の人に＋1と交代のボタンが並ぶ" width="1120" height="780" />
      </div>
    </section>

    <section id="features">
      <div class="wrap">
        <h2>特長</h2>
        <div class="cards">
          {features.map((f) => (
            <article class="card"><div class="ic" aria-hidden="true">{f.icon}</div><h3>{f.title}</h3><p>{f.text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section id="shots" class="alt">
      <div class="wrap">
        <h2>画面</h2>
        <div class="shots">
          {shots.map(([f, t, d]) => (
            <figure><img src={img(f)} alt={t} loading="lazy" width="1120" height="780" /><figcaption><b>{t}</b><span>{d}</span></figcaption></figure>
          ))}
        </div>
      </div>
    </section>

    <section id="start">
      <div class="wrap">
        <h2>はじめかた</h2>
        <p class="lead">3ステップ、5分ほどで使えます。</p>
        <ol class="steps">
          {steps.map(([t, d]) => (<li><b>{t}</b><span>{d}</span></li>))}
        </ol>
      </div>
    </section>

    <section id="faq" class="alt">
      <div class="wrap">
        <h2>よくある質問</h2>
        <div class="faq">
          {faq.map(([q, a]) => (<details><summary>{q}</summary><p>{a}</p></details>))}
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <p>{APP_NAME} は Twitch とは関係のない非公式ツールです。Twitch は Twitch Interactive, Inc. の商標です。</p>
      <p><a href={repoUrl}>GitHub</a> ・ <a href={`${repoUrl}/releases`}>リリース一覧</a> ・ <a href={`${repoUrl}/issues`}>不具合の報告</a></p>
    </div>
  </footer>
</Base>

<style is:global>
  .top { border-bottom: 1px solid var(--line); background: rgba(15, 17, 26, .9); position: sticky; top: 0; z-index: 5; backdrop-filter: blur(8px); }
  .top .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 0; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font-weight: 800; }
  .top nav { display: flex; gap: 18px; flex-wrap: wrap; font-size: 14px; }
  .top nav a { color: var(--dim); text-decoration: none; } .top nav a:hover { color: var(--text); }
  .hero { padding: 64px 0 40px; background: radial-gradient(900px 400px at 15% -10%, rgba(110, 168, 255, .18), transparent), radial-gradient(700px 360px at 95% 10%, rgba(62, 207, 142, .1), transparent); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 36px; align-items: center; }
  .hero-text { display: flex; flex-direction: column; gap: 18px; }
  .eyebrow { color: var(--accent); font-weight: 700; font-size: 14px; }
  h1 { font-size: clamp(28px, 4.6vw, 44px); }
  .hero-shot { border-radius: var(--radius); border: 1px solid var(--line); box-shadow: 0 24px 60px rgba(0, 0, 0, .5); }
  .alt { background: #121521; border-block: 1px solid var(--line); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; margin-top: 24px; }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; display: flex; flex-direction: column; gap: 8px; }
  .card .ic { font-size: 26px; } .card h3 { font-size: 17px; } .card p { color: var(--dim); font-size: 14.5px; }
  .shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 24px; }
  .shots figure { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .shots img { border-radius: 12px; border: 1px solid var(--line); }
  .shots figcaption { display: flex; flex-direction: column; font-size: 14px; color: var(--dim); } .shots figcaption b { color: var(--text); }
  .steps { list-style: none; counter-reset: s; padding: 0; margin: 24px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .steps li { counter-increment: s; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 18px 18px 64px; position: relative; display: flex; flex-direction: column; gap: 4px; }
  .steps li::before { content: counter(s); position: absolute; left: 16px; top: 16px; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: #06101f; font-weight: 800; }
  .steps span { color: var(--dim); font-size: 14.5px; }
  .faq { display: flex; flex-direction: column; gap: 10px; margin-top: 20px; max-width: 760px; }
  .faq details { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; }
  .faq summary { cursor: pointer; font-weight: 700; } .faq p { color: var(--dim); margin-top: 8px; font-size: 15px; }
  footer { padding: 36px 0 48px; color: var(--dim); font-size: 13px; } footer .wrap { display: flex; flex-direction: column; gap: 6px; }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; } .hero { padding-top: 36px; } }
</style>
